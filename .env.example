PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Optional: set the IPN ID registered with the same Pesapal environment.
PESAPAL_IPN_ID=
APP_BASE_URL=https://your-public-https-domain.example
DATABASE_PATH=.data/naroknest.sqlite
ADMIN_EMAIL=
ADMIN_PASSWORD=
